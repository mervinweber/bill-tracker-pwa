{
  "name": "bill-tracker-pwa",
  "version": "1.0.0",
  "type": "module",
  "description": "A Progressive Web App for tracking bills due each pay period",
  "main": "src/index.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit --project jsconfig.json",
    "verify:security-env": "node scripts/verify_security_env.mjs",
    "verify:production-pwa": "node scripts/verify_production_pwa.mjs"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@vitest/coverage-v8": "^0.34.6",
    "autoprefixer": "^10.4.17",
    "jsdom": "^20.0.3",
    "postcss": "^8.4.35",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  },
  "keywords": [
    "pwa",
    "bills",
    "tracker",
    "payroll"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.3.3",
    "tailwindcss": "^3.4.17"
